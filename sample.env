DISABLE_LOGGING=false
LOG_LEVEL=debug

KAFKA_URL=localhost:9092
KAFKA_CLIENT_ID=project-billing-account-update-processor
KAFKA_GROUP_ID=project-billing-account-update-processor
KAFKA_TOPIC=project.action.billingAccount.update
KAFKA_FROM_BEGINNING=false
KAFKA_SESSION_TIMEOUT_MS=60000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_HIGH_WATER_MARK=1
KAFKA_RECONNECT_DELAY_MS=5000
KAFKA_AUTOCREATE_TOPICS=false

# true: Challenge API tokens come from Keycloak (KEYCLOAK_*).
# Unset or false: they come from Auth0 (AUTH0_*), as before the migration.
USE_KEYCLOAK=true

AUTH0_URL=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_PROXY_SERVER_URL=

KEYCLOAK_ISSUER=https://keycloak.topcoder-dev.com/realms/topcoder-m2m-dev
KEYCLOAK_AUDIENCE=https://api.topcoder-dev.com
KEYCLOAK_TOKEN_URL=https://keycloak.topcoder-dev.com/m2m/token
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPE=read:challenges update:challenges

CHALLENGE_API_URL=https://api.topcoder-dev.com/v6/challenges
