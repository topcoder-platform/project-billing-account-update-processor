{
  "name": "project-billing-account-update-processor",
  "version": "1.0.0",
  "description": "Processes project billing account update events and updates eligible Topcoder challenges.",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "create-test-challenges": "tsx scripts/create-test-challenges.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "lint": "eslint src scripts test --max-warnings=0",
    "lint:fix": "eslint src scripts test --fix",
    "test": "tsx --test test/**/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "Topcoder",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@platformatic/kafka": "^2.6.1",
    "joi": "18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superagent": "^10.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/superagent": "^8.1.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "qs": "6.17.1"
  }
}
